<?xml version="1.0" encoding="UTF-8"?>
<!-- Deny web access to sync logs on IIS (which ignores .htaccess). -->
<configuration>
	<system.webServer>
		<security>
			<authorization>
				<remove users="*" roles="" verbs="" />
				<add accessType="Deny" users="*" />
			</authorization>
		</security>
	</system.webServer>
</configuration>
